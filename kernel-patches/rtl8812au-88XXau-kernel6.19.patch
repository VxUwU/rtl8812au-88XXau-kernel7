### 2. include/osdep_service_linux.h: kernel 6.16 timer API rename compat
--- include/osdep_service_linux.h.orig	2026-09-08 01:09:21.823384400 +0700
+++ include/osdep_service_linux.h	2026-09-08 01:09:21.856392637 +0700
@@ -349,6 +349,17 @@
 	return &(queue->queue);
 }
 
+/* --- kernel 6.16 timer API rename compat (added for 6.19 build) --- */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0))
+#ifndef from_timer
+#define from_timer(var, cb_timer, fieldname) timer_container_of(var, cb_timer, fieldname)
+#endif
+#ifndef del_timer_sync
+#define del_timer_sync(t) timer_delete_sync(t)
+#endif
+#endif
+/* --------------------------------------------------------------- */
+
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 14, 0))
 static inline void timer_hdl(struct timer_list *in_timer)
 #else

